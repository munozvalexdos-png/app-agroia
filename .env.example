# Gemini — nunca commitear la clave real
GEMINI_API_KEY=
# Opcional. Por defecto: gemini-2.5-flash (rápido, Edge-friendly)
GEMINI_MODEL=gemini-2.5-flash

# Visor de Administración (destino exclusivo de registros de campo)
NEXT_PUBLIC_ADMIN_VISOR_URL=https://visor-agrotolima.vercel.app
# Alias server-side del mismo origen (proxy /api/campo/sync)
ADMIN_VISOR_URL=https://visor-agrotolima.vercel.app
# Si el Visor define CAPTURE_INGEST_KEY, replicarla aquí para el proxy
# CAPTURE_INGEST_KEY=
